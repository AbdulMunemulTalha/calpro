# Copy this to .env.local for local development
# These are optional — the app works without them

# Google AdSense (set in src/components/ui/AdSlot.jsx directly)
# REACT_APP_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX

# Stripe (add payment links directly to PricingPage.jsx)
# REACT_APP_STRIPE_PRO_MONTHLY=https://buy.stripe.com/xxx
# REACT_APP_STRIPE_PRO_YEARLY=https://buy.stripe.com/xxx
# REACT_APP_STRIPE_TEAM=https://buy.stripe.com/xxx
